{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"YatDIP \u6570\u5b57\u56fe\u50cf\u5904\u7406","text":""},{"location":"#_1","title":"\u8bfe\u7a0b\u7b80\u4ecb","text":"<p>\u6570\u5b57\u56fe\u50cf\u5904\u7406\u5728\u5f53\u4eca\u65e0\u8bba\u662f\u8ba1\u7b97\u673a\u89c6\u89c9\u3001\u8ba1\u7b97\u673a\u56fe\u5f62\u5b66\u3001\u8fd8\u662f\u5728\u6a21\u5f0f\u8bc6\u522b\u9886\u57df\uff0c\u90fd\u662f\u8d77\u7740\u4e00\u79cd\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\u3002\u672c\u8bfe\u7a0b\u5c06\u4f1a\u7ed3\u5408\u4e0d\u540c\u7684\u7b97\u6cd5\uff0c\u4ece\u57fa\u7840\u5230\u76ee\u524d\u8f83\u4e3a\u5148\u524d\u7684\u6570\u5b57\u56fe\u50cf\u5904\u7406\u7b97\u6cd5\u5f53\u4e2d\u53bb\u4e0d\u65ad\u5b8c\u5584\u548c\u5b8c\u6210\u6570\u5b57\u56fe\u50cf\u5904\u7406\u7684\u8bfe\u7a0b\u548c\u4ecb\u7ecd\u3002</p> <p>\u9996\u5148\u6211\u4eec\u4f1a\u9996\u5148\u4ecb\u7ecd\u6570\u5b57\u56fe\u50cf\u5904\u7406\u662f\u4ec0\u4e48\uff0c\u5b83\u5bf9\u6211\u4eec\u6765\u8bf4\u7684\u610f\u4e49\u662f\u4ec0\u4e48\u3002\u5728\u8fd9\u4e00\u7ae0\u8282\u5f53\u4e2d\uff0c\u6211\u4eec\u4f1a\u9996\u5148\u73ed\u95e8\u5f04\u65a7\uff0c\u5c55\u793a\u4e0d\u540c\u6570\u5b57\u56fe\u50cf\u5904\u7406\u5728\u6211\u4eec\u79d1\u5b66\u7814\u7a76\u548c\u751f\u6d3b\u5f53\u4e2d\u7684\u4e0d\u540c\u7684\u5e94\u7528\u548c\u610f\u4e49\u3002\u7136\u540e\u6211\u4eec\u4f1a\u7ee7\u7eed\u5f80\u4e0b\u8bf4\u660e\uff0c\u4ecb\u7ecd\u4e0d\u540c\u65b9\u5411\u5728\u4e0d\u540c\u610f\u4e49\u4e0b\u7684\u4e00\u4e9b\u7814\u7a76\u65b9\u5411\u4ee5\u53ca\u6700\u65b0\u7684\u524d\u6cbf\u7684\u4ecb\u7ecd\u3002\u540c\u65f6\u6211\u4eec\u5728\u4ecb\u7ecd\u5b8c\u4e4b\u540e\uff0c\u4f1a\u9996\u5148\u4ecb\u7ecd\u6570\u5b57\u56fe\u50cf\u5904\u7406\u7684\u57fa\u7840\u77e5\u8bc6\uff0c\u5305\u62ec\u4ec0\u4e48\u662f\u6570\u5b57\u56fe\u50cf\uff0c\u6570\u5b57\u56fe\u50cf\u5f53\u4e2d\u4f1a\u6d89\u53ca\u5230\u7684\u8bb8\u591a\u4e0d\u540c\u7684\u5b9a\u4e49\u4ee5\u53ca\u4e0d\u540c\u7684\u542b\u4e49\u90fd\u8bf4\u660e\u51fa\u6765\u3002</p> <p>\u7136\u540e\u6211\u4eec\u4f1a\u4ecb\u7ecd\u4e0d\u540c\u6570\u5b57\u56fe\u50cf\u7684\u5904\u7406\u65b9\u5f0f\uff0c\u5305\u62ec\u7a7a\u95f4\u57df\u6ee4\u6ce2\u3001\u9891\u7387\u57df\u6ee4\u6ce2\u4ee5\u53ca\u5f62\u6001\u5b66\u5904\u7406\u3002\u8fd9\u4e09\u79cd\u5904\u7406\u65b9\u5f0f\u57fa\u672c\u6db5\u76d6\u4e86\u73b0\u884c\u6240\u6709\u6211\u4eec\u5e38\u89c1\u7684\u6570\u5b57\u56fe\u50cf\u5904\u7406\u7684\u57fa\u672c\u65b9\u6cd5\u8bba\uff0c\u4e5f\u4f5c\u4e3a\u6211\u4eec\u6211\u4eec\u540e\u7eed\u7ee7\u7eed\u5f00\u5c55\u4e0d\u540c\u5e94\u7528\u5b9e\u73b0\u7684\u65b9\u6cd5\u3002</p> <p>\u6700\u540e\u6211\u4eec\u4f1a\u4ecb\u7ecd\u6570\u7ec4\u56fe\u50cf\u5728\u4e0d\u540c\u9886\u57df\u5f53\u4e2d\u7684\u4e00\u4e9b\u5e94\u7528\uff0c\u5305\u62ec\u56fe\u50cf\u91cd\u5efa\u548c\u590d\u539f\u3001\u56fe\u50cf\u5206\u5272\u3001\u7279\u5f81\u63d0\u53d6\u3001\u56fe\u50cf\u914d\u51c6\u4ee5\u53ca\u56fe\u50cf\u538b\u7f29\u4e0e\u6c34\u5370\u4e94\u4e2a\u90e8\u5206\u7684\u5185\u5bb9\u3002</p> <p>\u5bf9\u4e8e\u5b66\u6709\u4f59\u529b\u7684\u540c\u5b66\uff0c\u6211\u4eec\u4f1a\u63d0\u4f9b\u66f4\u52a0\u8fdb\u4e00\u6b65\u7684\u5b66\u4e60\u7ae0\u8282\u4f9b\u540c\u5b66\u4eec\u9009\u5b66\uff0c\u5305\u62ec\u5c0f\u6ce2\u53d8\u6362\u548c\u6a21\u5f0f\u5206\u7c7b\u6a21\u5757\uff0c\u4f5c\u4e3a\u540e\u7eed\u8fdb\u9636\u7684\u5185\u5bb9\uff0c\u5404\u4f4d\u540c\u5b66\u4eec\u4e5f\u53ef\u4ee5\u9009\u4fee\u76f8\u5173\u7684\u8bfe\u7a0b\u6765\u5b8c\u6210\u76f8\u5e94\u7684\u5185\u5bb9\u3002</p>"},{"location":"#_2","title":"\u8bfe\u7a0b\u6559\u6388","text":"<p>ddd</p>"},{"location":"acknowledge/","title":"\u7248\u6743\u4e0e\u81f4\u8c22","text":"<p>ddd</p>"}]}